{
  "name": "lbk-launcher",
  "version": "2.23.1",
  "description": "Інсталятор українізаторів відеоігор",
  "author": {
    "name": "LBK Team",
    "email": "info@lbklauncher.com"
  },
  "license": "GPL-3.0-or-later",
  "main": "out/main/index.js",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "volta": {
    "node": "24.22.1",
    "pnpm": "11.4.0"
  },
  "scripts": {
    "dev": "install-electron && pnpm prebuild && electron-vite dev",
    "preview": "install-electron && electron-vite preview",
    "prebuild": "pnpm build:bridge && node scripts/build-spellfix.js",
    "build:bridge": "wireit",
    "dev:bridge": "pnpm --filter \"./packages/*\" --parallel run watch",
    "build": "electron-vite build",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "dist:win": "electron-builder --win --config electron-builder.config.cjs",
    "dist:linux": "electron-builder --linux --config electron-builder.config.cjs",
    "dist:mac": "electron-builder --mac --config electron-builder.config.cjs",
    "dist:win:local": "env-cmd pnpm build && pnpm dist:win",
    "dist:linux:local": "env-cmd pnpm build && pnpm dist:linux",
    "dist:mac:local": "env-cmd pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false pnpm dist:mac",
    "type-check": "tsc --noEmit && tsc --noEmit -p packages/lbk-bridge-core && tsc --noEmit -p packages/lbk-i18n && tsc --noEmit -p packages/lbk-bridge-decky && tsc --noEmit -p packages/lbk-bridge-millennium",
    "pretest:unit": "pnpm build:bridge",
    "test:unit": "vitest run",
    "lint": "eslint .",
    "find-unused": "knip",
    "format": "biome check --write .",
    "format:check": "biome check --max-diagnostics=200 .",
    "postinstall": "electron-builder install-app-deps",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "prepare": "husky"
  },
  "wireit": {
    "build:bridge": {
      "dependencies": [
        "./packages/lbk-bridge-core:build",
        "./packages/lbk-bridge-decky:build",
        "./packages/lbk-bridge-millennium:build"
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,json,css,scss}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mobily/ts-belt": "3.13.1",
    "@number-flow/react": "^0.6.2",
    "@sentry/electron": "8.2.0",
    "@sentry/react": "11.7.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@xstate/react": "6.1.0",
    "better-sqlite3": "13.0.3",
    "binarykvparser": "2.2.0",
    "chance": "1.1.13",
    "chrome-remote-interface": "0.34.0",
    "cyrillic-to-translit-js": "3.2.1",
    "electron-router-dom": "^2.1.1",
    "electron-store": "11.0.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fast-vdf": "3.1.1",
    "framer-motion": "13.4.6",
    "got": "16.0.0",
    "i18next": "26.4.6",
    "lru-cache": "11.5.3",
    "mixpanel-browser": "2.83.0",
    "node-7z": "3.0.0",
    "node-machine-id": "1.1.12",
    "p-limit": "7.3.3",
    "p-memoize": "8.0.0",
    "p-timeout": "7.0.2",
    "p-wait-for": "6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.18",
    "react-lazy-load-image-component": "^1.6.3",
    "react-lite-youtube-embed": "^3.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "registry-js": "1.16.1",
    "remark-breaks": "^4.0.0",
    "resedit": "3.1.0",
    "semver": "7.8.5",
    "shell-quote": "1.12.0",
    "tar": "7.5.22",
    "ts-pattern": "5.9.2",
    "write-file-atomic": "8.0.0",
    "ws": "8.22.0",
    "xstate": "5.33.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1",
    "node-gyp-build": "4.8.4"
  },
  "devDependencies": {
    "7zip-bin-full": "26.3.1",
    "@biomejs/biome": "2.5.15",
    "@eslint/js": "10.0.1",
    "@lbk/bridge-core": "workspace:*",
    "@lbk/i18n": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sentry/vite-plugin": "11.8.0",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/chance": "^1.1.8",
    "@types/chrome-remote-interface": "0.34.0",
    "@types/node": "24.19.0",
    "@types/node-7z": "2.1.11",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-lazy-load-image-component": "1.6.5",
    "@types/semver": "7.8.0",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react-swc": "4.3.3",
    "electron": "44.5.1",
    "electron-builder": "26.17.0",
    "electron-devtools-installer": "4.0.0",
    "electron-updater": "6.8.9",
    "electron-vite": "5.0.0",
    "env-cmd": "11.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "lucide": "^1.49.0",
    "lucide-react": "1.49.0",
    "morphicons": "^1.7.1",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.7",
    "vite-plugin-node-polyfills": "0.28.0",
    "vitest": "5.0.3",
    "wireit": "0.14.13"
  }
}
