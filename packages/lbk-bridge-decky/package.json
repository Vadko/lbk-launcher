{
  "name": "@lbk/bridge-decky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "wireit",
    "watch": "rollup -c -w"
  },
  "wireit": {
    "build": {
      "command": "rollup -c",
      "files": [
        "src/**",
        "plugin.json",
        "rollup.config.js",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../lbk-bridge-core:build",
        "../lbk-i18n:sources"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    }
  },
  "devDependencies": {
    "@decky/api": "1.1.3",
    "@decky/rollup": "1.0.2",
    "@lbk/bridge-core": "workspace:*",
    "@lbk/i18n": "workspace:*",
    "@types/react": "19.3.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "rollup": "4.62.4",
    "wireit": "0.14.13"
  }
}
